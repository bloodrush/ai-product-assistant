{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/chat.js": { "maxDuration": 30 },
    "api/export.js": { "maxDuration": 30 },
    "api/aggregate.js": { "maxDuration": 60 },
    "api/tracker-export.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
